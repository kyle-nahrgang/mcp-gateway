[Unit]
Description=MCP gateway (OAuth in front of selected local MCP servers)
After=network-online.target

[Service]
WorkingDirectory=%h/workspace/mcp-gateway
Environment=GATEWAY_CONFIG=%h/.config/mcp-gateway/config.json
ExecStart=/usr/bin/env node --disable-warning=ExperimentalWarning dist/src/main.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h/.local/share/mcp-gateway

[Install]
WantedBy=default.target
